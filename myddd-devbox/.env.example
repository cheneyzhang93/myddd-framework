# 复制为 .env 后按需修改；.env 不入库（仓根 .gitignore 已忽略 myddd-devbox/.env）。
# 本文件只列端口与凭据开关，一律不含真实口令。

# 必填：devbox.sh 与 compose 都会拒绝空值（MYSQL_ROOT_PASSWORD: ${...:?}）。
MYSQL_ROOT_PASSWORD=

# 选填：填了才创建非 root 的本地应用账号 myddd（见 seed/mysql/02-app-user.sh）。
MYDDD_DB_PASSWORD=


MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
ROCKETMQ_NAMESRV_HOST_PORT=9876
ROCKETMQ_BROKER_HOST_PORT=10911
ROCKETMQ_CONSOLE_HOST_PORT=8088
XXLJOB_HOST_PORT=9099
XXLJOB_ACCESS_TOKEN=
# 控制台与客户端上报同端口：镜像自带 -Dserver.port=8858。
SENTINEL_HOST_PORT=8858
