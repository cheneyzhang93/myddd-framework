<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.deep361.myddd.smoke</groupId>
    <artifactId>bom-smoke</artifactId>
    <version>9.9.9</version>
    <packaging>pom</packaging>

    <description>BOM 消费端契约回归夹具：版本号刻意与框架发布版本不同（9.9.9），用于证明 import BOM 后 myddd-* 版本不串味</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-dependencies</artifactId>
                <version>1.0.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 直接自钉坐标：验证父 POM 的显式 version 生效 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>
        <!-- 自钉 BOM import：验证 import 顺序陷阱（spring-cloud 传递导入 2.3.0，必须由 2.4.0 胜出） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <!-- SCA 传递导入把 rocketmq 家族管理为 5.3.1，父 POM 单点显式升 client 到 5.5.1：验证"单点显式版本覆盖传递导入"生效 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
        </dependency>
        <!-- 传递 import 的传递坐标：验证"import 一次拿到全套版本" -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 本项目模块：验证 ${project.version} 不串味（必须为 1.0.0-SNAPSHOT，而非夹具的 9.9.9） -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-common</artifactId>
        </dependency>
        <!-- Plan 1 就有、但 CI 契约此前漏检的两个坐标：内核 DDD 基类与测试基座（后者拖入 testcontainers 家族） -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-ddd</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-test-starter</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <!-- Plan 2 新增模块：验证 6 个新坐标进 BOM 后消费端可解析（版本由 BOM 提供，此处刻意不写 version） -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-port</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-statemachine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-rule</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-domain-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-archunit</artifactId>
        </dependency>
        <!-- Plan 3 适配器模块：每建一个模块就在这一节追加一条（必须是 <dependencies>，
             CI 的契约检查看的是 </dependencyManagement> 之后的解析结果） -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-persistence-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-cache-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-consistency-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-feign-starter</artifactId>
        </dependency>
        <!-- 自钉三方坐标（Boot BOM 不管理 archunit）：验证版本经 import BOM 到达消费端 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
        </dependency>
        <!-- 框架自钉、业务免版本拿到：转换器注解必须随 BOM 到达，否则每个业务工程都要自己猜 MapStruct 版本 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
    </dependencies>
</project>
