<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.deep361.myddd</groupId>
        <artifactId>myddd-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>myddd-feign-starter</artifactId>

    <name>myddd-feign-starter</name>
    <description>OpenFeign 适配 Starter：出站 traceId 透传（X-Trace-Id + W3C traceparent）与远程统一错误体还原为 BizException</description>

    <dependencies>
        <!-- 内核契约：TraceContext / ErrorCode / BizException 全部来自这里 -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-kernel-common</artifactId>
        </dependency>

        <!-- Spring 装配面（版本全部由 myddd-dependencies 管理，此处不写版本号） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Feign 契约类型：RequestInterceptor / RequestTemplate / ErrorDecoder / feign.Response -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- 只用于解析远程统一错误体的 code/message/traceId 三个字段（Jackson 3，与内核同一份版本真源） -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 仅激活：executions/configuration 继承父 POM（LINE+BRANCH 双门槛，阈值 0.60） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
