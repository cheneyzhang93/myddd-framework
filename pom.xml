        <module>myddd-kernel/myddd-kernel-rule</module>
        <module>myddd-test-starter</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-09-20T00:00:00Z</project.build.outputTimestamp>

        <!-- ===== 三方依赖版本（唯一真源） ===== -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- RocketMQ 家族单一联动点：client/remoting/common 三个登记条目共用本属性（Plan 4 Task 31，R3），
             升级只改这里一处；acl/logging 不登记、由下方 enforcer bannedDependencies 封禁，理由见 dependencyManagement 里那段裁定 -->
        <rocketmq.version>5.5.1</rocketmq.version>
        <xxl-job.version>3.4.2</xxl-job.version>
        <sentinel.version>1.8.9</sentinel.version>
        <redisson.version>4.7.0</redisson.version>
        <springdoc.version>3.1.1</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- ArchUnit：Boot BOM 不管理，自钉；规则库与业务工程必须同版本，否则切片/包匹配语义会漂移 -->
        <archunit.version>1.5.0</archunit.version>

        <!-- ===== devbox 本地环境镜像（唯一真源，test-starter 资源过滤消费；Plan 3 核验后定稿） ===== -->
        <myddd.devbox.image.mysql>mysql:8.4</myddd.devbox.image.mysql>
        <myddd.devbox.image.redis>redis:7.4-alpine</myddd.devbox.image.redis>
        <myddd.devbox.image.kafka>apache/kafka:4.0.0</myddd.devbox.image.kafka>
        <myddd.devbox.image.rocketmq>apache/rocketmq:5.3.2</myddd.devbox.image.rocketmq>
        <myddd.devbox.image.rocketmq-console>apacherocketmq/rocketmq-dashboard:2.0.0</myddd.devbox.image.rocketmq-console>
        <myddd.devbox.image.xxljob-admin>xuxueli/xxl-job-admin:3.4.2</myddd.devbox.image.xxljob-admin>
        <myddd.devbox.image.sentinel-dashboard>bladex/sentinel-dashboard:1.8.8</myddd.devbox.image.sentinel-dashboard>

        <!-- ===== Maven 插件版本 ===== -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-wrapper-plugin.version>3.3.4</maven-wrapper-plugin.version>
        <!-- enforcer requirePluginVersions 会检查生命周期绑定的 site-plugin（缺省 3.12.1），必须显式钉版本，否则连 validate 都失败 -->
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

        <!-- ===== 覆盖率门槛（内核/领域模块在各自 POM 覆盖为 0.80） ===== -->
        <myddd.jacoco.minimum>0.60</myddd.jacoco.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ⚠️ 导入顺序有意义：import 冲突时"先声明者胜"。
                 spring-cloud-dependencies 会传递导入 resilience4j-bom:2.3.0，
                 故本框架自钉的 resilience4j-bom 必须排在其之前，否则 2.4.0 被静默降级。 -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 三方 BOM 导入 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 自钉三方坐标（Boot 4 生态滞后的组件走"厂商 core + 自研装配"） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- RocketMQ 家族版本裁定（Plan 4 Task 31，R3）：
                 无法把全家族钉到 5.5.1 —— org.apache.rocketmq:rocketmq-acl 与 rocketmq-logging 在 Central
                 没有 5.5.1 坐标（本机 curl 一手 404 取证，旧家族停在 5.3.1）。
                 裁定：只钉 client，让 remoting/common 随它同版本；acl/logging 由 enforcer bannedDependencies
                 封禁——一旦 SCA 的 RocketMQ starter 把它们带进来（SCA 2025.1.0.0 管成 5.3.1），构建直接失败，
                 而不是静默产出"5.5.1 client + 5.3.1 acl"这种只在生产报鉴权错的组合。
                 broker 侧（devbox 的 apache/rocketmq:5.3.2）与 client 5.5.1 的兼容性由 Task 40 的真投递 IT 证明；
                 若被证伪，改 ${rocketmq.version} 这一个属性即可，不改任何代码。 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-remoting</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-common</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <!-- Sentinel：Boot/Cloud 的 BOM 都不管理它，自钉。只引 sentinel-core（判定本体），
                 dashboard 上报走 sentinel-transport 的可选 SPI，本框架不主动装配它。 -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-core</artifactId>
                <version>${sentinel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- 本项目模块（版本随手父 POM，业务工程 import BOM 后无需写版本） -->
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-kernel-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-kernel-ddd</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-kernel-port</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-kernel-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-kernel-statemachine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-kernel-rule</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-domain-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-archunit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-test-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-persistence-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-cache-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-consistency-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-web-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-feign-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-mq-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-mq-rocketmq-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-mq-kafka-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-job-spring-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-job-xxljob-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-resilience-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-limiter-sentinel-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-limiter-resilience4j-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-auth-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-auth-satoken-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.deep361.myddd</groupId>
                <artifactId>myddd-auth-security-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>integration-test</id>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-build-environment</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>[3.9.0,4.0.0)</version>
                                    </requireMavenVersion>
                                    <requireJavaVersion>
                                        <version>[21,)</version>
                                    </requireJavaVersion>
                                    <banDuplicatePomDependencyVersions/>
                                    <!-- R3：SCA 的 RocketMQ starter 会带进 5.3.1 的 acl/logging，与自钉的 5.5.1 client 混版本。
                                         这两条把"混版本"从生产事故变成构建失败。excludes 语法：groupId:artifactId:versionRange。 -->
                                    <bannedDependencies>
                                        <excludes>
                                            <exclude>org.apache.rocketmq:rocketmq-acl</exclude>
                                            <exclude>org.apache.rocketmq:rocketmq-logging</exclude>
                                        </excludes>
                                        <searchTransitive>true</searchTransitive>
                                        <message>RocketMQ 家族按 R3 只允许 client/remoting/common 三个坐标（版本 ${rocketmq.version}）；rocketmq-acl 与 rocketmq-logging 被禁，因为它们没有与 client 同步的版本，混进来就是静默的版本错配。</message>
                                    </bannedDependencies>
                                    <requirePluginVersions>
                                        <message>所有 Maven 插件必须显式声明版本</message>
                                    </requirePluginVersions>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-wrapper-plugin</artifactId>
                    <version>${maven-wrapper-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${myddd.jacoco.minimum}</minimum>
                                            </limit>
                                            <!-- 分支覆盖率与行覆盖率同门槛：只约束 LINE 时"分支写不测"不会被任何环节拦住
                                                 （实测基线 2026-09-25：全部 jar 模块 BRANCH ≥ 88.46%，内核与 archunit 为 100%） -->
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${myddd.jacoco.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <!-- 发布私服时启用（-Prelease）：随主构件产出 sources/javadoc -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
